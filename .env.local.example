# =============================================================================
# Architect 2.0 — local environment
#
# Copy this file to `.env.local` and fill in the values.
#
# Required for the product to work:
#   GROQ_API_KEY             — the agent that actually builds your app
#   NEXT_PUBLIC_SUPABASE_*   — auth and the project database
#
# Optional integrations:
#   GITHUB_CLIENT_ID/SECRET  — repo import and push
#   VERCEL_TOKEN             — real deployments
#
# Without the Groq key the builder refuses to run rather than faking a build.
# That is deliberate: a silent fake is worse than an honest absence.
# =============================================================================

# --- Groq (REAL: the build agent) -------------------------------------------
# Create a key at https://console.groq.com/keys
#
# Server-only. Do NOT rename this to NEXT_PUBLIC_ — anything NEXT_PUBLIC_ is
# inlined into the browser bundle and your key would be published.
GROQ_API_KEY=

# Which model builds your apps. Any model id Groq serves will work; the ones the
# settings screen offers are the ones known to handle tool calling well.
# GROQ_MODEL=openai/gpt-oss-120b

# Only change this if you are self-hosting an OpenAI-compatible endpoint.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Supabase (REAL: auth + Postgres) ---------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key. New dashboards: Project Settings → API Keys → publishable key.
# Older dashboards: the "anon public" key (works with NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- GitHub (REAL: repo import + push) --------------------------------------
# https://github.com/settings/developers → OAuth App
# Authorisation callback URL: https://<your-site>/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Vercel (REAL: deployments) ---------------------------------------------
# https://vercel.com/account/tokens
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# --- App --------------------------------------------------------------------
# Used to build OAuth redirect URLs on the server. On the client we prefer
# window.location.origin, so localhost and Vercel previews work without changes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
