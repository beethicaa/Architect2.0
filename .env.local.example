# =============================================================================
# Architect 2.0 — local environment
#
# Copy this file to `.env.local` and fill in the values. Only Supabase is
# required: everything else in the product is a mocked flow and runs without
# credentials.
# =============================================================================

# --- Supabase (REAL: auth + Postgres) ---------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key. New dashboards: Project Settings → API Keys → publishable key.
# Older dashboards: the "anon public" key (works with NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- App --------------------------------------------------------------------
# Used to build OAuth redirect URLs on the server. On the client we prefer
# window.location.origin, so localhost and Vercel previews work without changes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
